# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# App Store Connect のAPIキー。~/.appstoreconnect/ に置く運用だが、
# 取り違えてリポジトリに入れてしまうと配信権限がそのまま漏れる。
*.p8
AuthKey_*

# 手元でしか使わない手順書。Apple ID やアカウントに固有の値（key ID、
# issuer ID、証明書の置き場所）が出てくるものは、公開リポジトリではなく
# ここに置く。リポジトリの外に出したくないだけで、秘密の値そのものは
# ここにも書かない（それは ~/.appstoreconnect/ に置く）。
docs/local/

# wranglerがログイン後に作るローカルのキャッシュ。アカウントIDと
# アカウント名（＝Cloudflareに登録したメールアドレス）が入る。無ければ
# wranglerが作り直すので、リポジトリに入れる必要はない。
# server/.gitignore にも同じ行があるが、リポジトリ直下で `wrangler` を
# 叩くと直下にも作られるため、こちらにも要る。
.wrangler/
